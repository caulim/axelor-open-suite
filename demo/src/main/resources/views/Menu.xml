<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views
  https://axelor.com/xml/ns/object-views/object-views_7.4.xsd">

  <menuitem name="menu-demo" title="Address Book" order="1000"
    if="__config__.app.isApp('demo')" icon="app-demo"/>

  <menuitem name="menu-title" parent="menu-demo" title="Title" action="title"/>
  <menuitem name="menu-contact" parent="menu-demo" title="Contact" action="contact"/>
  
  <action-view name="title" title="Title" model="com.axelor.apps.demo.db.Title">
    <view type="grid" name="title-grid"/>
    <view type="form" name="title-form"/>
  </action-view>

  <action-view name="contact" title="Contact" model="com.axelor.apps.demo.db.Contact">
    <view type="grid" name="contact-grid"/>
    <view type="form" name="contact-form"/>
  </action-view>

</object-views>
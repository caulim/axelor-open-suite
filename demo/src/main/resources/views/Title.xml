<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_7.2.xsd">

  <grid name="title-grid" title="Title"
    model="com.axelor.apps.demo.db.Title">
    <field name="code"/>
    <field name="name"/>
  </grid>

  <form name="title-form" title="Title" model="com.axelor.apps.demo.db.Title"
    width="large">
    <panel name="mainPanel">
    	<field name="code"/>
      <field name="name"/>
    </panel>
  </form>

</object-views>